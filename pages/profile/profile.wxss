/* pages/profile/profile.wxss —— 我的页（与全局主题统一） */
.brand-header { display: flex; flex-direction: column; align-items: center; padding: 28px 0 20px; }
.brand-avatar {
  width: 72px; height: 72px; border-radius: 50%;
  background: #fff; padding: 4px; box-sizing: border-box;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1); border: 3px solid rgba(255, 255, 255, 0.4);
}
.brand-name { margin-top: 12px; font-size: 22px; font-weight: 800; color: var(--primary-dark); }
.brand-sub { margin-top: 4px; font-size: 13px; color: var(--muted); }

.card-label { font-size: 11px; color: var(--primary); font-weight: 700; letter-spacing: 1px; margin-bottom: 8px; }
.oid { font-size: 18px; font-weight: 600; color: var(--text); letter-spacing: 1px; }
.tip { margin-top: 8px; font-size: 12px; color: var(--muted); line-height: 1.6; }
.line { font-size: 15px; padding: 8px 0; border-bottom: 1px solid rgba(0, 0, 0, 0.04); color: var(--text); }
.line:last-child { border-bottom: none; }

.share-btn {
  background: var(--gradient); color: #fff; border: none;
  padding: 12px 20px; border-radius: 14px; font-size: 14px; font-weight: 700;
  box-shadow: 0 4px 12px rgba(var(--primary-rgb), 0.25); text-align: center;
}
.share-btn.block { width: 100%; margin-top: 8px; }
.ghost-btn {
  background: var(--tint); color: var(--primary-dark);
  padding: 12px 20px; border-radius: 14px; font-size: 14px; font-weight: 700;
  text-align: center; margin-top: 12px; width: 100%;
}
.canvas-wrap { margin-top: 16px; display: flex; flex-direction: column; align-items: center; }
.share-canvas {
  width: 300px; height: 440px;
  background: linear-gradient(160deg, #EDD5E8 0%, #F5DCEE 100%);
  border-radius: 24px; box-shadow: 0 8px 24px rgba(181, 126, 220, 0.18);
}
