/* pages/addons/addons.wxss —— 添加项（对齐源文件紫色主题） */
.page { padding: 14px; padding-bottom: 40px; }
.hint { margin-bottom: 14px; }
.hint-title { font-size: 20px; font-weight: 800; color: var(--primary-dark); }
.hint-sub { font-size: 13px; color: var(--muted); margin-top: 4px; line-height: 1.5; }

.cat-row { display: flex; align-items: center; gap: 8px; margin: 14px 2px 8px; }
.cat-tag {
  min-width: 20px; height: 20px; padding: 0 6px; border-radius: 10px;
  background: var(--gradient); color: #fff; font-size: 11px; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.cat-name { font-size: 14px; font-weight: 700; color: var(--text); }

.module-card {
  display: flex; align-items: center; gap: 12px;
  background: #fff; border-radius: 18px; padding: 14px;
  margin-bottom: 10px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}
.module-icon {
  width: 44px; height: 44px; border-radius: 14px; flex-shrink: 0;
  background: var(--tint); display: flex; align-items: center; justify-content: center; font-size: 24px;
}
.module-body { flex: 1; min-width: 0; }
.module-name { font-size: 16px; font-weight: 700; }
.module-desc { font-size: 12px; color: var(--muted); margin-top: 2px; }
