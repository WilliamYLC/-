<!-- pages/module-detail/module-detail.wxml —— 按 type 渲染（卡片视觉 1:1 对齐源文件） -->
<view class="page-wrap">

  <!-- ===== 待办 todo ===== -->
  <block wx:if="{{type === 'todo'}}">
    <view class="card">
      <view class="card-header">
        <text class="card-icon">📋</text>
        <text class="card-title">待办清单</text>
        <text class="card-sub sm">{{todos.length}} 项</text>
      </view>
      <view class="chips">
        <view class="chip {{todoCat===c?'active':''}}" wx:for="{{cats}}" wx:key="*this" data-c="{{item}}" bindtap="onTodoCat">{{item}}</view>
      </view>
      <view class="input-row">
        <input class="input" placeholder="添加待办…" value="{{newTodo}}" bindinput="onNewTodo" confirm-type="done" bindconfirm="addTodo"/>
        <view class="btn sm" bindtap="addTodo">添加</view>
      </view>
      <view class="list">
        <view class="list-item" wx:for="{{todos}}" wx:key="_id">
          <view class="item-check {{item.done?'on':''}}" data-id="{{item._id}}" data-done="{{item.done}}" bindtap="toggleTodo">✓</view>
          <view class="item-main"><view class="title-row {{item.done?'done':''}}">{{item.content}}</view><view class="meta">{{item.cat}}</view></view>
          <text class="del-btn" data-id="{{item._id}}" bindtap="delTodo">×</text>
        </view>
        <view wx:if="{{todos.length===0}}" class="empty">还没有待办，添加一条吧</view>
      </view>
    </view>
  </block>

  <!-- ===== 体重 number ===== -->
  <block wx:if="{{type === 'number'}}">
    <view class="card">
      <view class="card-header">
        <text class="card-icon">⚖️</text>
        <text class="card-title">体重记录</text>
      </view>
      <view class="input-row">
        <text class="card-sub" style="align-self:center;">🌅 早晨</text>
        <input class="input" type="digit" placeholder="kg" value="{{wMorning}}" bindinput="onWM"/>
        <view class="btn sm" bindtap="saveWeight">记录</view>
      </view>
      <view class="input-row">
        <text class="card-sub" style="align-self:center;">🌙 晚上</text>
        <input class="input" type="digit" placeholder="kg" value="{{wEvening}}" bindinput="onWE"/>
        <view class="btn sm" bindtap="saveWeight">记录</view>
      </view>
      <view class="summary">
        <view class="summary-box"><view class="num">{{wMorning||'--'}}</view><view class="label">晨重</view></view>
        <view class="summary-box"><view class="num">{{wEvening||'--'}}</view><view class="label">晚重</view></view>
        <view class="summary-box"><view class="num">{{wMorning&&wEvening? (wEvening-wMorning):'--'}}</view><view class="label">波动</view></view>
      </view>
    </view>
  </block>

  <!-- ===== 记账 account ===== -->
  <block wx:if="{{type === 'account'}}">
    <view class="card">
      <view class="card-header">
        <text class="card-icon">💵</text>
        <text class="card-title">今日记账</text>
      </view>
      <view class="toggle">
        <view class="toggle-btn {{accType==='expense'?'active':''}}" data-type="expense" bindtap="setAccType">支出</view>
        <view class="toggle-btn {{accType==='income'?'active':''}}" data-type="income" bindtap="setAccType">收入</view>
      </view>
      <view class="input-row">
        <input class="input" type="digit" placeholder="金额" value="{{amount}}" bindinput="onAmount"/>
        <input class="input" placeholder="分类" value="{{accCat}}" bindinput="onAccCat"/>
      </view>
      <view class="input-row">
        <input class="input" placeholder="备注" value="{{accNote}}" bindinput="onAccNote"/>
        <view class="btn sm" bindtap="addAccount">记一笔</view>
      </view>
      <view class="summary">
        <view class="summary-box"><view class="num">{{monthIncome}}</view><view class="label">本月收入</view></view>
        <view class="summary-box"><view class="num">{{monthExpense}}</view><view class="label">本月支出</view></view>
        <view class="summary-box"><view class="num">{{monthBalance}}</view><view class="label">结余</view></view>
      </view>
      <view class="list">
        <view class="list-item" wx:for="{{accList}}" wx:key="_id">
          <view class="item-main"><view class="title-row">{{item.note||item.category}} · {{item.amount}}</view><view class="meta">{{item.type==='income'?'收入':'支出'}} · {{item.date}}</view></view>
          <text class="del-btn" data-id="{{item._id}}" bindtap="delAcc">×</text>
        </view>
        <view wx:if="{{accList.length===0}}" class="empty">还没有记账</view>
      </view>
    </view>
  </block>

  <!-- ===== 文字记录 text(diet/feeling) ===== -->
  <block wx:if="{{type === 'text'}}">
    <view class="card">
      <view class="card-header">
        <text class="card-icon">{{module.tag}}</text>
        <text class="card-title">{{module.name}}</text>
      </view>
      <block wx:if="{{module.id === 'diet'}}">
        <view class="input-row">
          <input class="input" placeholder="餐次" value="{{dietMeal}}" bindinput="onDietMeal"/>
          <input class="input" type="digit" placeholder="卡路里" value="{{dietCal}}" bindinput="onDietCal"/>
        </view>
        <view class="input-row">
          <input class="input" placeholder="吃了什么…" value="{{value}}" bindinput="onValue"/>
          <view class="btn sm" bindtap="addDiet">添加</view>
        </view>
        <view class="list">
          <view class="list-item" wx:for="{{dietList}}" wx:key="_id">
            <view class="item-main"><view class="title-row">{{item.content}}</view><view class="meta">{{item.meal}} · {{item.calories?item.calories+'kcal':''}}</view></view>
            <text class="del-btn" data-id="{{item._id}}" data-mod="diet" bindtap="delText">×</text>
          </view>
          <view wx:if="{{dietList.length===0}}" class="empty">今天还没记录饮食</view>
        </view>
      </block>
      <block wx:else>
        <textarea class="input" placeholder="写下今日感受…" value="{{value}}" bindinput="onValue" style="min-height:90px;"></textarea>
        <view class="btn block" bindtap="addFeeling">记录感受</view>
        <view class="list">
          <view class="list-item" wx:for="{{feelingList}}" wx:key="_id">
            <view class="item-main"><view class="title-row">{{item.content}}</view></view>
            <text class="del-btn" data-id="{{item._id}}" data-mod="feeling" bindtap="delText">×</text>
          </view>
          <view wx:if="{{feelingList.length===0}}" class="empty">还没有记录</view>
        </view>
      </block>
    </view>
  </block>

  <!-- ===== 系统内容 content(wuxing/english) ===== -->
  <block wx:if="{{type === 'content'}}">
    <view class="card" wx:if="{{module.id === 'wuxing'}}">
      <view class="card-header"><text class="card-icon">🔮</text><text class="card-title">每日五行穿衣颜色</text></view>
      <view wx:if="{{wuxing}}">
        <view class="chips">
          <view class="chip active">今天</view><view class="chip">明天</view><view class="chip">后天</view>
        </view>
        <view class="summary">
          <view class="summary-box" wx:for="{{wuxing.lucky}}" wx:key="*this"><view class="num">{{item}}</view><view class="label">大吉色</view></view>
        </view>
        <view class="card-sub" style="margin-top:8px;">五行：{{wuxing.element}}（{{wuxing.gan}}{{wuxing.zhi}}）· 忌：{{wuxing.avoid}}</view>
      </view>
    </view>
    <view class="card" wx:if="{{module.id === 'english'}}">
      <view class="card-header"><text class="card-icon">💬</text><text class="card-title">每日英语练习</text></view>
      <view style="font-size:16px;font-weight:700;margin:6px 0;">{{english.sentence}}</view>
      <view style="margin-top:10px;"><text style="font-size:20px;font-weight:800;color:var(--primary-dark);">{{english.word}}</text> <text class="card-sub">/ {{english.meaning}}</text></view>
    </view>
  </block>

  <!-- ===== 心情日记 mood ===== -->
  <block wx:if="{{type === 'mood'}}">
    <view class="card">
      <view class="card-header"><text class="card-icon">🥰</text><text class="card-title">心情日记</text></view>
      <view class="mood-row">
        <text class="mood-emoji {{moodEmoji===e?'selected':''}}" wx:for="{{moods}}" wx:key="*this" data-e="{{item}}" bindtap="setMood">{{item}}</text>
      </view>
      <textarea class="input" placeholder="今天的心情…" value="{{moodText}}" bindinput="onMoodText" style="min-height:80px;"></textarea>
      <view class="btn block" bindtap="saveMood">保存心情</view>
      <view class="list">
        <view class="list-item" wx:for="{{moodList}}" wx:key="_id"><view class="item-main"><view class="title-row">{{item.emoji}} {{item.text}}</view><view class="meta">{{item.date}}</view></view></view>
      </view>
    </view>
  </block>

  <!-- ===== 运动 exercise ===== -->
  <block wx:if="{{type === 'exercise'}}">
    <view class="card">
      <view class="card-header"><text class="card-icon">🏊‍♀️</text><text class="card-title">运动打卡</text></view>
      <view class="grid2">
        <view class="dash-card" wx:for="{{exKinds}}" wx:key="*this" data-k="{{item}}" bindtap="openEx">
          <text class="emoji">{{item==='有氧'?'🏃':(item==='无氧'?'🏋️':'🔥')}}</text>
          <text class="title">{{item}}</text>
          <text class="desc">点击输入分钟</text>
        </view>
      </view>
      <view class="list">
        <view class="list-item" wx:for="{{exList}}" wx:key="_id">
          <view class="item-main"><view class="title-row">{{item.kind}} · {{item.minutes}} 分钟</view><view class="meta">{{item.date}}</view></view>
          <text class="del-btn" data-id="{{item._id}}" bindtap="delEx">×</text>
        </view>
        <view wx:if="{{exList.length===0}}" class="empty">今天还没打卡</view>
      </view>
    </view>
    <view wx:if="{{showEx}}" class="modal-mask" bindtap="closeEx">
      <view class="modal-card" catchtap="noop">
        <view class="modal-title">🏃 {{exKind}} 运动</view>
        <view class="card-sub" style="margin:6px 0 10px;">输入运动了多少分钟</view>
        <input class="input" type="number" placeholder="分钟" value="{{exMin}}" bindinput="onExMin"/>
        <view class="btn block" style="margin-top:12px;" bindtap="saveEx">确认打卡</view>
      </view>
    </view>
  </block>

  <!-- ===== 体态 body ===== -->
  <block wx:if="{{type === 'body'}}">
    <view class="card grad">
      <view style="font-size:20px;font-weight:800;margin-bottom:6px;">每天 15 分钟体态急救训练</view>
      <view style="font-size:13px;opacity:.95;margin-bottom:12px;">挺拔体态 · 改善圆肩含胸</view>
      <view class="btn" style="background:#fff;color:var(--primary-dark);" bindtap="doBody">{{bodyDone?'今日已完成 ✓':'完成今日 15 分钟训练'}}</view>
    </view>
  </block>

  <!-- ===== 自媒体灵感 media ===== -->
  <block wx:if="{{type === 'media'}}">
    <view class="card">
      <view class="card-header"><text class="card-icon">💡</text><text class="card-title">自媒体灵感</text></view>
      <view class="chips">
        <view class="chip {{mediaStatus===s?'active':''}}" wx:for="{{mediaStatuses}}" wx:key="*this" data-s="{{item}}" bindtap="setMediaStatus">{{item}}</view>
      </view>
      <view class="input-row">
        <input class="input" placeholder="平台" value="{{mediaPlat}}" bindinput="onMediaPlat"/>
        <input class="input" placeholder="标题" value="{{mediaTitle}}" bindinput="onMediaTitle"/>
      </view>
      <textarea class="input" placeholder="内容…" value="{{mediaContent}}" bindinput="onMediaContent" style="min-height:70px;"></textarea>
      <view class="btn block" bindtap="addMedia">保存自媒体记录</view>
      <view class="list">
        <view class="list-item" wx:for="{{mediaList}}" wx:key="_id">
          <view class="item-main"><view class="title-row">{{item.title||item.content}}</view><view class="meta">{{item.platform}} · {{item.status}}</view></view>
          <text class="del-btn" data-id="{{item._id}}" bindtap="delMedia">×</text>
        </view>
        <view wx:if="{{mediaList.length===0}}" class="empty">还没有灵感记录</view>
      </view>
    </view>
  </block>

  <!-- ===== 年度目标 goals ===== -->
  <block wx:if="{{type === 'goals'}}">
    <view class="card">
      <view class="card-header"><text class="card-icon">🧸</text><text class="card-title">年度目标</text></view>
      <view class="input-row">
        <input class="input" placeholder="目标内容" value="{{goalText}}" bindinput="onGoalText"/>
        <input class="input" placeholder="分类" value="{{goalCat}}" bindinput="onGoalCat"/>
      </view>
      <view class="btn block" bindtap="addGoal">添加</view>
      <view class="list">
        <view class="list-item" wx:for="{{goalList}}" wx:key="_id">
          <view class="item-check {{item.done?'on':''}}" data-id="{{item._id}}" data-done="{{item.done}}" bindtap="toggleGoal">✓</view>
          <view class="item-main"><view class="title-row {{item.done?'done':''}}">{{item.text}}</view><view class="meta">{{item.category}}</view></view>
          <text class="del-btn" data-id="{{item._id}}" bindtap="delGoal">×</text>
        </view>
        <view wx:if="{{goalList.length===0}}" class="empty">还没有目标</view>
      </view>
    </view>
  </block>

  <!-- ===== 旅游规划 travel ===== -->
  <block wx:if="{{type === 'travel'}}">
    <view class="card">
      <view class="card-header"><text class="card-icon">✈️</text><text class="card-title">旅游规划</text></view>
      <view class="input-row">
        <input class="input" placeholder="目的地" value="{{travelTitle}}" bindinput="onTravelTitle"/>
      </view>
      <view class="input-row">
        <input class="input" placeholder="备注/行程" value="{{travelDesc}}" bindinput="onTravelDesc"/>
        <view class="btn sm" bindtap="addTravel">新建</view>
      </view>
      <view class="list">
        <view class="list-item" wx:for="{{travelList}}" wx:key="_id">
          <view class="item-main"><view class="title-row">{{item.title}}</view><view class="meta">{{item.desc}}</view></view>
          <text class="del-btn" data-id="{{item._id}}" bindtap="delTravel">×</text>
        </view>
        <view wx:if="{{travelList.length===0}}" class="empty">还没有旅行计划</view>
      </view>
    </view>
  </block>

</view>
