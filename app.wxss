/* app.wxss —— 设计系统，1:1 对齐源文件 LifePlan 的视觉令牌 */

page {
  /* 与源文件 :root 完全一致 */
  --primary: #B57EDC;
  --primary-rgb: 181, 126, 220;
  --primary-dark: #7B4FA0;
  --primary-dark-rgb: 123, 79, 160;
  --tint: #F5EEF5;
  --accent: #F9A8D4;
  --gradient: linear-gradient(135deg, #E8B4E8 0%, #F0C4E8 30%, #F5D4D4 70%, #F5DEE0 100%);
  --bg: linear-gradient(160deg, #EDD5E8 0%, #F5DCEE 100%);
  --card: #FFFFFF;
  --text: #1F2937;
  --muted: #6B7280;
  --radius: 20px;
  --shadow: 0 8px 24px rgba(181, 126, 220, 0.12);

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Source Han Sans SC", "Noto Sans CJK SC", "Microsoft YaHei", "Segoe UI", Roboto, system-ui, sans-serif;
  min-height: 100vh;
}

view, text, scroll-view { box-sizing: border-box; }

/* ---------- 通用容器 ---------- */
.page-wrap { padding: 14px; padding-bottom: 40px; }

/* ---------- 顶栏（对齐 .topbar） ---------- */
.topbar {
  position: sticky; top: 0; z-index: 50;
  background: rgba(245, 235, 245, 0.92);
  padding: 14px 18px; padding-top: calc(14px + env(safe-area-inset-top, 0px));
  display: flex; align-items: center; justify-content: space-between;
}
.topbar-left { display: flex; align-items: center; gap: 12px; }
.page-title { font-size: 22px; font-weight: 800; color: var(--primary-dark); }
.checkin-btn {
  background: var(--gradient); color: #fff; border: none;
  padding: 8px 16px; border-radius: 20px; font-size: 13px; font-weight: 700;
  box-shadow: 0 4px 12px rgba(var(--primary-rgb), 0.25);
}

/* ---------- HERO（对齐 .hero） ---------- */
.hero {
  background: var(--gradient); color: #fff;
  border-radius: 22px; padding: 18px;
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 12px;
  box-shadow: 0 8px 24px rgba(var(--primary-rgb), 0.25);
}
.hero-text { flex: 1; }
.hero-badge {
  display: inline-block; background: rgba(255, 255, 255, 0.25);
  padding: 3px 10px; border-radius: 20px; font-size: 11px; margin-bottom: 6px;
}
.hero-title { font-size: 22px; font-weight: 800; line-height: 1.25; margin-bottom: 4px; }
.hero-sub { font-size: 13px; opacity: 0.97; line-height: 1.6; min-height: 48px; margin-top: 6px; display: flex; align-items: center; }
.hero-done { font-size: 12px; margin-top: 4px; opacity: 0.95; }
.hero-progress { text-align: center; margin-left: 12px; }

/* 进度环：用 SVG 实现（WXSS conic-gradient 支持不稳定） */
.ring { width: 64px; height: 64px; }
.ring-pct { font-size: 20px; font-weight: 800; fill: #fff; }
.ring-label { font-size: 10px; fill: rgba(255, 255, 255, 0.95); }

/* ---------- 区块标题（对齐 .section-title） ---------- */
.section-title { font-size: 16px; font-weight: 900; color: var(--primary-dark); margin: 6px 2px 8px; }
.section-title .en { font-size: 10px; color: var(--primary); letter-spacing: 1px; display: block; margin-bottom: 1px; }

/* ---------- 双列网格（对齐 .grid2） ---------- */
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

/* ---------- 仪表盘模块卡（对齐 .dash-card） ---------- */
.dash-card {
  background: #fff; border-radius: 16px; padding: 12px;
  box-shadow: 0 3px 10px rgba(0, 0, 0, 0.04);
  display: flex; flex-direction: column; gap: 2px;
}
.dash-card .emoji { font-size: 22px; }
.dash-card .title { font-size: 13px; font-weight: 700; }
.dash-card .desc { font-size: 10px; color: var(--muted); line-height: 1.2; }

/* ---------- 详情卡片（对齐 .card） ---------- */
.card {
  background: #fff; padding: 14px; border-radius: 18px;
  margin-bottom: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}
.card-header { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.card-icon { font-size: 24px; }
.card-title { font-size: 17px; font-weight: 800; flex: 1; }
.card-sub { font-size: 12px; color: var(--muted); }
.card-sub.sm { font-size: 11px; }

/* ---------- 输入框（对齐 .input/.select/textarea） ---------- */
.input, .select, textarea {
  width: 100%; border: none; outline: none; background: var(--tint);
  border-radius: 14px; padding: 11px 14px; font-size: 15px; color: var(--text);
  box-sizing: border-box; min-height: 44px; line-height: 1.4;
}
.input-row { display: flex; gap: 8px; align-items: center; margin-bottom: 10px; flex-wrap: wrap; }
.input-row > .input,
.input-row > .select,
.input-row > textarea { flex: 1; min-width: 0; }
.input-row > .btn.sm { flex: 0 0 auto; }
/* picker view：不要把 app.wxss 的 .input padding 应用到 picker 内部 view，否则双层 padding 切字 */
.input.picker { display: flex; align-items: center; padding: 10px 14px; min-height: 44px; line-height: 1.4; word-break: keep-all; }

/* ---------- 按钮（对齐 .btn） ---------- */
.btn {
  background: var(--gradient); color: #fff; border: none;
  padding: 12px 20px; border-radius: 14px; font-size: 14px; font-weight: 700;
  box-shadow: 0 4px 12px rgba(var(--primary-rgb), 0.25);
  text-align: center;
}
.btn.block { width: 100%; margin-bottom: 12px; }
.btn.sm { padding: 4px 12px; border-radius: 10px; font-size: 12px; }
.btn.primary { background: var(--primary, #7c5cff); color: #fff; box-shadow: 0 4px 12px rgba(var(--primary-rgb), 0.25); }
.btn.ghost { background: var(--tint, #f1edff); color: var(--primary-dark, #5b3fd6); box-shadow: none; }

/* ---------- 切换（对齐 .toggle） ---------- */
.toggle { display: inline-flex; background: var(--tint); border-radius: 14px; padding: 4px; margin-bottom: 12px; }
.toggle-btn { padding: 8px 18px; border-radius: 12px; font-size: 14px; font-weight: 700; color: var(--muted); }
.toggle-btn.active { background: #fff; color: var(--primary-dark); box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06); }

/* ---------- 芯片（对齐 .chip） ---------- */
.chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
.chip { padding: 7px 13px; border-radius: 18px; background: var(--tint); color: var(--muted); font-size: 13px; font-weight: 600; border: 2px solid transparent; }
.chip.active { background: rgba(var(--primary-rgb), 0.12); color: var(--primary-dark); border-color: rgba(var(--primary-rgb), 0.25); }

/* ---------- 汇总盒（对齐 .summary） ---------- */
.summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 14px; }
.summary-box { background: var(--tint); border-radius: 16px; padding: 12px 6px; text-align: center; }
.summary-box .num { font-size: 18px; font-weight: 800; color: var(--primary-dark); }
.summary-box .label { font-size: 11px; color: var(--muted); margin-top: 2px; }

/* ---------- 列表（对齐 .list/.list-item） ---------- */
.list { display: flex; flex-direction: column; }
.list-item {
  padding: 10px 0; display: flex; align-items: flex-start; gap: 10px;
  border-bottom: 1px solid rgba(0, 0, 0, 0.04);
}
.list-item .item-main { flex: 1; min-width: 0; }
.list-item .title-row { font-size: 15px; line-height: 1.3; }
.list-item.done .title-row { opacity: 0.5; text-decoration: line-through; }
.list-item .meta { font-size: 11px; color: var(--muted); margin-top: 2px; }
.item-check {
  width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0; margin-top: 2px;
  border: 2px solid var(--primary); display: flex; align-items: center; justify-content: center;
  font-size: 13px; color: #fff; background: transparent;
}
.item-check.on { background: var(--primary); }
.del-btn { color: #9CA3AF; font-size: 18px; padding: 0 4px; }

/* ---------- 渐变高亮卡（体态等，对齐源 .card style=gradient） ---------- */
.card.grad { background: var(--gradient); color: #fff; }

/* ---------- 空态 ---------- */
.empty { text-align: center; color: var(--muted); font-size: 13px; padding: 24px 0; }
